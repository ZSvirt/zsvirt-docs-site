{
  "name": "zsvirt-docs-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "release:package": "node scripts/release.mjs package",
    "release:verify": "node scripts/release.mjs verify",
    "deploy": "node scripts/deploy.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "fumadocs-mdx && next build && node scripts/verify-search-build.mjs && node scripts/package-search.mjs",
    "preview": "node scripts/preview.mjs",
    "search:start": "node search-runtime/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:search:e2e": "node tests/search.e2e.mjs",
    "test:site:e2e": "node tests/site.e2e.mjs",
    "test:terraform": "python3 scripts/test_terraform_docs_sync.py",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@orama/orama": "3.1.18",
    "@orama/tokenizers": "3.1.18",
    "fumadocs-core": "16.10.5",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-ui": "16.10.5",
    "mdast-util-to-markdown": "2.1.2",
    "mdast-util-to-string": "4.0.0",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/mdx": "2.0.14",
    "@types/node": "25.9.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "serve-handler": "6.1.7",
    "tailwindcss": "4.3.1",
    "tar": "7.5.22",
    "typescript": "6.0.3",
    "unist-util-visit": "5.1.0"
  }
}
